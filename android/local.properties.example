## Copia este archivo como local.properties (Android Studio añade sdk.dir solo).
## local.properties está en .gitignore: la clave NUNCA se sube al repositorio.
MAPS_API_KEY=pon_aqui_tu_clave_de_maps_sdk_for_android
## Dirección de la API de Respira (servidor/api/index.php).
##  - En Plesk:            https://TU_DOMINIO/respira/api/index.php
##  - En tu PC (php -S):   http://192.168.1.100:8080/index.php   (misma WiFi que el móvil)
##  - Desde el emulador:   http://10.0.2.2:8080/index.php
## Si no se pone, se usa http://192.168.1.100:8080
URL_SERVIDOR=https://TU_DOMINIO/respira/api/index.php
